rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Les utilisateurs peuvent lire les métriques publiques du dashboard de Karamokho DRAMÉ
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;

      match /platforms/{platform}/{document=**} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Collection des métriques en direct mises à jour par Webhook / Admin SDK
    match /liveMetrics/{metricId} {
      allow read: if true;
      allow write: if false; // Verrouillé pour les clients webs/mobiles directs
    }

    // Collection des sessions TikTok Live
    match /tiktokLiveSessions/{sessionId} {
      allow read: if true;
      allow write: if false; // Réservé au Backend

      match /messages/{messageId} {
        allow read: if true;
        allow write: if false;
      }
    }

    // Règle par défaut : accès refusé aux documents non spécifiés
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
